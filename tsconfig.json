{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "useDefineForClassFields": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "outDir": "./dist/out-tsc"
  },
  "angularCompilerOptions": {"strictTemplates": false, "strictInjectionParameters": true}
}
