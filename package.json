{
  "name": "aniplayer-angular-tizen",
  "version": "2.2.0-angular.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "mal:relay": "node tools/mal-phone-relay.mjs",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "node --test tests/integration.test.mjs tests/tv-navigation.test.mjs tests/mal-relay.test.mjs && node --experimental-strip-types --test tests/audio-fingerprint.test.mjs",
    "test:all": "npm run typecheck && npm run test && npm run build",
    "tizen:pack": "powershell -ExecutionPolicy Bypass -File ./tools/build-tizen.ps1",
    "tizen:deploy": "powershell -ExecutionPolicy Bypass -File ./tools/deploy-tizen.ps1"
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "typescript": "~6.0.0"
  }
}
